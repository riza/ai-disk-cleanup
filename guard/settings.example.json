{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.ai-disk-cleanup/disk_guard.py || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
